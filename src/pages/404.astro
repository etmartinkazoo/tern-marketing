---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <section class="wrap nf">
    <pre class="mono">E486: Pattern not found</pre>
    <h1>Nothing at this address.</h1>
    <p>The page moved or never existed. Try <a href="/docs/">the docs</a> or go <a href="/">home</a>.</p>
  </section>
</Base>

<style>
  .nf {
    padding-top: 120px;
    max-width: 720px;
  }
  pre {
    margin: 0 0 18px;
    color: var(--red);
    font-size: 14px;
  }
  h1 {
    margin: 0 0 14px;
    font-size: clamp(32px, 5vw, 48px);
  }
  p {
    color: var(--muted);
    font-size: 18px;
  }
</style>
